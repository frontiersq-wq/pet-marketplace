# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template belongs in version control.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma client is generated from the schema by `npm run db:generate`
/src/generated/prisma

# local sqlite database (recreate with `npm run db:reset`)
*.db
*.db-journal
*.db-wal
*.db-shm

# agent tooling installed by `npx prisma init` (regenerable, not app code)
/.agents
/.claude/skills
/skills-lock.json

# machine-local Claude Code settings
/.claude/settings.local.json
