# Copy to .env and fill in. `.env` is gitignored; this file is committed.

# SQLite database file, resolved relative to prisma7.config.ts (project root).
# Phase 4 swaps this for a Postgres connection string.
DATABASE_URL="file:./prisma/dev.db"

# Auth.js session encryption secret. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
