# Copy to .env and fill in. `.env` is gitignored; this file is committed.

# PostgreSQL connection string — get this from Neon (neon.tech).
# Neon gives you a URL like:
#   postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js session encryption secret. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Public URL of the site — used for JSON-LD, sitemap and OAuth redirects.
# Set to your Vercel URL (e.g. https://pet-marketplace.vercel.app) in production.
AUTH_URL="http://localhost:3000"
